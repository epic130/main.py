import os  # Librería para leer variables del servidor de forma segura
import telebot

# Railway leerá el token de forma segura desde la pestaña "Variables"
TOKEN = os.getenv("TELEGRAM_TOKEN")
bot = telebot.TeleBot(TOKEN)

# Responde al comando /start o /ayuda
@bot.message_handler(commands=['start', 'ayuda'])
def enviar_bienvenida(message):
    bot.reply_to(message, "¡Hola! Soy tu bot creado desde Termux y alojado en Railway. ¿En qué te ayudo?")

# Responde con eco a cualquier otro mensaje de texto
@bot.message_handler(func=lambda message: True)
def hacer_eco(message):
    bot.reply_to(message, f"Me dijiste: {message.text}")

# Mantiene al bot escuchando nuevos mensajes continuamente
print("El bot está encendido y escuchando...")
bot.infinity_polling()
